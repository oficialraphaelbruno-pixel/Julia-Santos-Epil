# =============================================================
# Julia Santos Epil | Studio Manager — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure na hospedagem.
# NUNCA versione valores reais.
# =============================================================

# URL pública do site (sem barra no final). Ex.: https://www.juliasantosepil.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Empresa exibida na página inicial (slug cadastrado no banco)
NEXT_PUBLIC_DEFAULT_BUSINESS_SLUG=julia-santos-epil

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) ou a antiga "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) ou a antiga "service_role key".
# SOMENTE NO SERVIDOR. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Segredo usado para gerar identificadores anônimos de IP (limitação de abuso).
# Gere com: openssl rand -hex 32
RATE_LIMIT_SALT=

# ---- Fase 2 (ainda não utilizadas) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://SEU-DOMINIO/api/integracoes/google/callback
# RESEND_API_KEY=
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
