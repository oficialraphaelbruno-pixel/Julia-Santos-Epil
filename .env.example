# =============================================================
# Julia Santos Epil | Studio Manager — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure na hospedagem.
# NUNCA versione valores reais.
# =============================================================

# URL pública do site (sem barra no final). Ex.: https://www.juliasantosepil.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Empresa exibida na página inicial (slug cadastrado no banco)
NEXT_PUBLIC_DEFAULT_BUSINESS_SLUG=julia-santos-epil

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) ou a antiga "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) ou a antiga "service_role key".
# SOMENTE NO SERVIDOR. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# OPCIONAL: se vazio, é derivado automaticamente de SUPABASE_SECRET_KEY.
RATE_LIMIT_SALT=

# ---- Fase 2: integrações ----
# OPCIONAL: se vazio, é derivado de SUPABASE_SECRET_KEY (trocar essa chave exige reconectar o Google).
INTEGRATIONS_ENCRYPTION_KEY=
# Necessário apenas para os lembretes automáticos (a Vercel envia no agendador). Gere com: openssl rand -hex 24
CRON_SECRET=

# Google Agenda (OAuth 2.0) — ver docs/GOOGLE-AGENDA.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional (padrão: NEXT_PUBLIC_SITE_URL + /api/integracoes/google/callback)
GOOGLE_REDIRECT_URI=

# E-mail transacional via SMTP (Resend, Brevo, Amazon SES, Gmail Workspace...)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente verificado no provedor. Ex.: agendamentos@juliasantosepil.com.br
EMAIL_FROM=

# WhatsApp Business Cloud API (opcional; modelos aprovados pela Meta)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_CONFIRMACAO=
WHATSAPP_TEMPLATE_LEMBRETE=
WHATSAPP_TEMPLATE_CANCELAMENTO=
WHATSAPP_TEMPLATE_REAGENDAMENTO=
WHATSAPP_TEMPLATE_RECEBIDO=
# Recebimento de mensagens (webhook) — ver docs/escritorio/05-INTEGRACOES.md
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Escritório de Inteligência ----
# Meta Ads (Marketing API). Fase 1: somente leitura (ads_read).
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=

# Google Sheets (conta de serviço; JSON em uma linha). Somente no servidor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# IA do escritório web. Somente no servidor. Sem chave, os módulos de IA ficam indisponíveis.
ANTHROPIC_API_KEY=
# Limite de gasto mensal com IA (USD). Ao atingir, novas chamadas são bloqueadas.
AI_MONTHLY_BUDGET_USD=
